# Google Sheets ID (visible dans l'URL du sheet)
SHEET_ID=your_google_sheet_id_here

# Chemins vers les fichiers OAuth Google
CREDENTIALS_PATH=../credentials.json
TOKEN_PATH=../token.json

# Clé API Anthropic pour génération IA des emails de relance
# Sans cette clé, l'API utilise un template fixe en fallback
ANTHROPIC_API_KEY=your_anthropic_api_key_here
